{
  "title": "macmini-ops demo",
  "locale": "en",
  "host": "127.0.0.1",
  "port": 8095,
  "publicUrl": "http://127.0.0.1:8095",
  "llm": {
    "enabled": true,
    "escalateAfter": 2,
    "cooldownHours": 1,
    "backends": [
      {
        "name": "gateway",
        "type": "openai",
        "baseUrl": "http://127.0.0.1:18030/v1",
        "model": "demo-model"
      }
    ]
  },
  "remediation": {
    "dryRun": true,
    "cooldownSec": 600,
    "allow": {}
  },
  "agents": [
    {
      "id": "server",
      "type": "host",
      "intervalSec": 60,
      "services": [],
      "diskWarnPct": 97,
      "diskCritPct": 99,
      "memWarnFreePct": 3
    },
    {
      "id": "llm",
      "type": "llm-app",
      "name": "Demo AI chat",
      "intervalSec": 10,
      "model": {
        "url": "http://127.0.0.1:18030/v1/models",
        "name": "demo-model",
        "gatewayHealthUrl": "http://127.0.0.1:18030/health"
      },
      "app": {
        "apiUrl": "http://127.0.0.1:18800/health",
        "webUrl": "http://127.0.0.1:18800/",
        "chatEverySec": 30,
        "chatPath": "http://127.0.0.1:18030/v1/chat/completions"
      },
      "playbook": [
        "- Demo: the model server is a mock that fails on purpose for 70 seconds."
      ]
    },
    {
      "id": "sites",
      "type": "sites",
      "intervalSec": 300,
      "sites": [
        {
          "id": "homepage",
          "name": "Company homepage (mock)",
          "url": "http://127.0.0.1:18800/",
          "critical": true
        },
        {
          "id": "old-blog",
          "name": "old-blog.invalid",
          "url": "https://old-blog.invalid"
        }
      ]
    }
  ],
  "gateway": {
    "host": "127.0.0.1",
    "port": 18030,
    "cooldownSec": 30,
    "firstByteMs": 5000,
    "providers": {
      "primary": {
        "baseUrl": "http://127.0.0.1:18800/v1"
      },
      "backup": {
        "baseUrl": "http://127.0.0.1:18801/v1"
      }
    },
    "models": {
      "demo-model": [
        {
          "provider": "primary",
          "model": "demo-model"
        },
        {
          "provider": "backup",
          "model": "backup-model"
        }
      ]
    }
  }
}
